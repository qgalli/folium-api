# Todos deben tener un archivo llamado `.env` para guardar claves y llaves que no pueden ser públicas (no pueden aparecer en GitHub).
# Cuando tengan creado el archivo copien los contenidos de este ejemplo adentro.


# ─── Django ─────────────────────────────────────────────────────────────────────────────

# Clave secreta de Django. Generá una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=folium_db
POSTGRES_USER=folium_user
POSTGRES_PASSWORD=your-password-here

# ─── CORS ────────────────────────────────────────────────────────────────────────────────
# URL(s) del frontend que pueden hacer requests a esta API.
# En producción, reemplazá con la URL real de tu frontend.
# Para múltiples orígenes, separá con coma: https://app.com,https://www.app.com
FRONTEND_URLS=http://localhost:3000

# ─── Mercado Pago ────────────────────────────────────────────────────────────────────────
MERCADOPAGO_PUBLIC_KEY=your-public-key-here
MERCADOPAGO_ACCESS_TOKEN=your-access-token-here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

